{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:api\" \"pnpm run dev:dashboard\"",
    "dev:api": "dotenv -e .env -- cross-env PORT=5000 pnpm --filter @workspace/api-server dev",
    "dev:dashboard": "dotenv -e .env -- cross-env PORT=3000 BASE_PATH=/ pnpm --filter @workspace/admin-dashboard dev",
    "db:init": "dotenv -e .env -- pnpm --filter @workspace/scripts run db:init",
    "db:seed": "dotenv -e .env -- pnpm --filter @workspace/scripts run seed",
    "db:setup": "dotenv -e .env -- pnpm --filter @workspace/scripts run db:setup",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "pnpm --filter @workspace/api-server start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "dotenv": "^17.4.1",
    "dotenv-cli": "^11.0.0"
  }
}
